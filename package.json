{
  "name": "a1-property-services",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "clean:next": "node scripts/clean-next-cache.mjs",
    "dev:clean": "node scripts/clean-next-cache.mjs && next dev",
    "build": "next build --webpack",
    "build:images": "node scripts/optimize-images.mjs",
    "generate:article-images": "node scripts/generate-article-images-fal.mjs",
    "build:article-images": "node scripts/rebuild-article-image-variants.mjs",
    "build:hero-video": "node scripts/generate-hero-video.mjs",
    "build:hero-video:ai": "py -3.12 scripts/generate-hero-i2v.py",
    "upscale-gallery": "node scripts/upscale-gallery-sources.mjs",
    "build:images:gallery": "npm run upscale-gallery && npm run build:images",
    "build:feed": "node scripts/generate-feed.mjs",
    "generate:redirects": "node scripts/generate-redirects.mjs",
    "validate:redirects": "node scripts/validate-migration-redirects.mjs",
    "audit:migration": "node scripts/audit-migration-ready.mjs",
    "audit:ranking": "node scripts/audit-ranking-pages.mjs",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "audit:lighthouse:preview": "node scripts/lighthouse-audit.mjs --url https://preview.a1pslandscape.com",
    "build:all": "npm run generate:redirects && npm run build:images && npm run build && npm run build:feed && npm run postbuild:validate && npm run validate:redirects && npm run link:health",
    "build:deploy": "npm run generate:redirects && npm run build:images && npm run build && npm run build:feed && npm run postbuild:validate && npm run validate:redirects",
    "build:deploy:fast": "npm run generate:redirects && npm run build && npm run build:feed && npm run postbuild:validate && npm run validate:redirects",
    "start": "npx serve out",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "compress-images": "node scripts/compress-images.mjs",
    "postbuild:validate": "node scripts/postbuild-validate.mjs",
    "link:health": "node scripts/link-health-check.mjs",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "preview": "npm run build:deploy && wrangler dev",
    "indexnow:submit": "node --env-file=.env.local scripts/submit-indexnow.mjs",
    "deploy": "npm run build:deploy && wrangler deploy && npm run indexnow:submit",
    "cf:sync-redirects": "node scripts/sync-cloudflare-redirects.mjs",
    "cf:sync-ai-crawlers": "node scripts/sync-cloudflare-ai-crawlers.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "clsx": "^2.1.0",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fal-ai/client": "^1.10.1",
    "@next/bundle-analyzer": "^16.3.5",
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "critters": "^0.0.23",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "wrangler": "^4.131.1"
  }
}
